# Copy this file to .env and fill it in. Never share or commit your .env file.

# Required: get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: your email (read-only access). Use an app password, not your normal password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Optional settings
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_DATA_DIR=~/.daily-assistant
